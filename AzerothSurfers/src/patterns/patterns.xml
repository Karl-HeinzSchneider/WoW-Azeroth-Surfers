         them. A new or changed pattern changes what a seed lays out. -->
    <Script file="jump.lua"/>
    <Script file="hurdle.lua"/>
    <Script file="wall.lua"/>
    <Script file="barriers.lua"/>
    <Script file="platform.lua"/>
    <Script file="enemy.lua"/>
    <Script file="tower.lua"/>
    <Script file="stairs.lua"/>
    <Script file="corridor.lua"/>
    <Script file="ambush.lua"/>
    <Script file="guard.lua"/>
    <Script file="slalom.lua"/>
    <Script file="rooftops.lua"/>
    <Script file="gauntlet.lua"/>
    <Script file="stampede.lua"/>
    <Script file="tunnel.lua"/>
    <Script file="terrace.lua"/>
    <Script file="bridge.lua"/>
    <Script file="fork.lua"/>
    <Script file="lowbeams.lua"/>
    <Script file="choice.lua"/>
    <Script file="crawlway.lua"/>
    <!-- Never picked by weight: the track lays it out where a zone ends. -->
    <Script file="gate.lua"/>
</Ui>
