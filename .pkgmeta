# BigWigs packager (https://github.com/BigWigsMods/packager). The checkout is copied into
# .release/Surfer/ and move-folders lifts each addon to the top of the zip, so every root entry
# that is not an addon must be ignored below, or it ships inside the addon's folder. Dotfiles
# and git-ignored paths are skipped on their own.

package-as: Surfer

move-folders:
  Surfer/Surfer: Surfer

ignore:
  - Surfer_Dev
  # Root tooling (the root src/ would also collide with Surfer/src/).
  - tests
  - docs
  - screenshots
  - src
  - package.json
  - package-lock.json
  - tsconfig.json
  - stylua.toml
  - CLAUDE.md
  - "*/CLAUDE.md"
  - "*.md"
  # LuaLS annotations; no TOC loads them.
  - Surfer/src/types.lua
